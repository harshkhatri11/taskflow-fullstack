# ===== TaskFlow backend environment variables =====
# Copy this file to `.env` (git-ignored) and fill in real values.
# Spring Boot does NOT read .env files by itself. Set these as real
# environment variables (IntelliJ Run Configuration, shell export, or Docker).

# --- Required (no defaults, app fails at startup if missing) ---
TASKFLOW_DB_USERNAME=your_db_username
TASKFLOW_DB_PASSWORD=your_db_password
# Generate with: openssl rand -base64 48
TASKFLOW_JWT_SECRET=replace_with_a_long_random_base64_string

# --- Optional (defaults shown, uncomment only to override) ---
# TASKFLOW_DB_HOST=localhost
# TASKFLOW_DB_PORT=5432
# TASKFLOW_DB_NAME=taskFlow
# TASKFLOW_REDIS_HOST=localhost
# TASKFLOW_REDIS_PORT=6379
# TASKFLOW_JWT_ACCESS_EXPIRY_MS=900000
# TASKFLOW_JWT_REFRESH_EXPIRY_DAYS=7
# TASKFLOW_CORS_ALLOWED_ORIGINS=http://localhost:4200